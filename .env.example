NODE_ENV=production
PORT=3000

# Comma separated list, or * for every origin (never use * together with credentials).
CORS_ORIGIN=http://localhost:8080,https://chat.example.com

# Required for horizontal scaling. redis://[:password@]host:port/db
# A room holds two people, and the roster that says so has to be readable by
# every process; per-process state doubles the cap. Production refuses to start
# without REDIS_URL, even with USE_MEMORY_STORE=true below.
REDIS_URL=redis://localhost:6379/0
# Set true to run without Redis (development or test NODE_ENV only, single instance).
USE_MEMORY_STORE=false

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_SEND_MAX=20
RATE_LIMIT_SOCKET_CONNECT_MAX=30
# Session creations. With a shared Redis the limiter is global, so this is the
# budget every replica's visitors share - raise it if many users sit behind one
# NAT or egress IP.
RATE_LIMIT_SESSION_MAX=30
SOCKET_HEARTBEAT_MS=15000
PRESENCE_TTL_MS=45000

# History. MESSAGE_CACHE_SIZE is how far a linear scan (poll lookups, id probes)
# may walk; MESSAGE_HISTORY_MAX is how many rows a room keeps, which is also how
# far "load older" can page back. MESSAGE_RETENTION_S is the life of a room's
# rows and is refreshed by traffic, so a quiet room does not lose its history.
MESSAGE_CACHE_SIZE=200
MESSAGE_HISTORY_MAX=1000
MESSAGE_RETENTION_S=2592000
# Rows one history read returns; a client asks for the next page by sequence.
HISTORY_PAGE_SIZE=50
SESSION_TTL_S=43200

# Media uploads (photos, video, audio, any file). Text messages are capped at
# 50,000 characters by the app itself, not by env.
# Needs shared storage when running more than one replica.
UPLOAD_DIR=uploads
MEDIA_MAX_BYTES=52428800
MEDIA_MAX_PER_MESSAGE=5
MEDIA_TTL_S=604800

# Trust the first X proxy hops (set 1 behind nginx, 2 behind CDN + LB).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
