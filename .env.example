NODE_ENV=production
PORT=3000

# Comma separated list, or * for every origin (never use * together with credentials).
CORS_ORIGIN=http://localhost:8080,https://chat.example.com

# Required for horizontal scaling. redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0
# Set true to run without Redis (single instance only, no scaling).
USE_MEMORY_STORE=false

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_SEND_MAX=20
RATE_LIMIT_SOCKET_CONNECT_MAX=30
SOCKET_HEARTBEAT_MS=15000
PRESENCE_TTL_MS=45000

# Cache
MESSAGE_CACHE_SIZE=200
MESSAGE_CACHE_TTL_S=3600
SESSION_TTL_S=43200

# Media uploads (photos, video, audio, any file). Text messages are capped at
# 50,000 characters by the app itself, not by env.
# Needs shared storage when running more than one replica.
UPLOAD_DIR=uploads
MEDIA_MAX_BYTES=52428800
MEDIA_MAX_PER_MESSAGE=5
MEDIA_TTL_S=604800

# Trust the first X proxy hops (set 1 behind nginx, 2 behind CDN + LB).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
