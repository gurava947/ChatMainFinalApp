# InChat environment — placeholders only. Copy to .env.local and fill in.
# .env.local is gitignored; never commit a real key.

# Supabase project: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Used by migrations and RLS tests; must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres:YOUR-DB-PASSWORD@YOUR-PROJECT-REF.supabase.co:5432/postgres
