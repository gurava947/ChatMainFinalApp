{
  "name": "groupchat-realtime",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade real-time group chat (Express + Socket.io + Redis)",
  "license": "MIT",
  "main": "src/server.js",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "build": "npm run build:client",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "build:client": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "multer": "^2.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
